# ============================================================
#  GIZZAR — Variáveis de Ambiente
# ============================================================

# URL base da loja (definida automaticamente na Vercel se omitida)
NEXT_PUBLIC_SITE_URL=https://gizzar.vercel.app

# Integração InfinitePay (Checkout Integrado)
# Sua InfiniteTag cadastrada na InfinitePay (sem o símbolo $)
# Exemplo: se sua tag for $gizzar, coloque apenas gizzar
INFINITEPAY_HANDLE=

# Endpoint da API InfinitePay (opcional, já possui valor padrão em produção)
# INFINITEPAY_API_URL=https://api.infinitepay.io/invoices/public/checkout/links
